# ==============================================================================
# HR Policy Assistant - Environment Configuration Template
# ==============================================================================

# --- Generation LLM via Groq (OpenAI-compatible) ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=60

# --- Evaluation Judge LLM (OpenAI-compatible / Gemini) ---
GOOGLE_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_API_KEY=your_eval_judge_api_key_here
EVAL_JUDGE_MODEL=openai/gpt-oss-120b

# --- Local Embeddings (Free, runs offline via HuggingFace) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# --- Vector Store (ChromaDB) ---
CHROMA_DIR=data/chroma
COLLECTION_NAME=hr_policies

# --- Ingestion & Retrieval Settings ---
CHUNK_SIZE=600
CHUNK_OVERLAP=150
TOP_K=3
RELEVANCE_THRESHOLD=0.68

# --- Observability & Tracing (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=hr-policy-bot
# LANGSMITH_HIDE_INPUTS=false
# LANGSMITH_HIDE_OUTPUTS=false

# --- Application Configuration ---
HR_CONTACT_EMAIL=hr@yourcompany.com

# --- Evaluation Pipeline ---
EVAL_MAX_CONCURRENCY=2
EVAL_JUDGE_REQUESTS_PER_MINUTE=0

